{
  "name": "lumen",
  "version": "0.2.0",
  "description": "A desktop AI code editor powered by Claude, with access to your whole system",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-rebuild -f -w node-pty",
    "dist": "electron-packager . Lumen --platform=darwin --arch=arm64 --out=dist --overwrite --app-bundle-id=com.lumen.editor --ignore=^/dist --asar.unpackDir=node_modules/node-pty"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.312",
    "@anthropic-ai/sdk": "^1.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@electron/rebuild": "^4.2.1",
    "electron": "^45.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jerry5379/lumen.git"
  },
  "keywords": [
    "claude",
    "electron",
    "code-editor",
    "ai",
    "claude-code"
  ]
}
